[sub_resource type="GDScript" id="GDScript_gqa8o"]
script/source = "@tool
extends PanelContainer

@export var rivet_color: Color = Color(\"4B534A\")
@export var rivet_radius: float = 3.0
@export var rivet_margin: float = 8.0

func _ready():
	# Ensure drawing updates if the panel is resized
	resized.connect(queue_redraw)

func _draw():
	var rect = get_rect()
	var positions = [
		Vector2(rivet_margin, rivet_margin), # Top-Left
		Vector2(rect.size.x - rivet_margin, rivet_margin), # Top-Right
		Vector2(rivet_margin, rect.size.y - rivet_margin), # Bottom-Left
		Vector2(rect.size.x - rivet_margin, rect.size.y - rivet_margin) # Bottom-Right
	]
	
	for pos in positions:
		draw_circle(pos, rivet_radius, rivet_color)
"

